# Required: https://www.last.fm/api/account/create
LASTFM_API_KEY=replace-with-your-lastfm-api-key
LASTFM_USERNAME=replace-with-your-lastfm-username

# MCP HTTP server
MCP_HOST=0.0.0.0
MCP_PORT=3000
# Host publication is loopback-only by default. Change only when your proxy runs elsewhere.
MCP_BIND_ADDRESS=127.0.0.1
MCP_PUBLIC_PORT=3000
# Comma-separated hostnames accepted by Host validation. Add your public hostname.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Last.fm client safeguards
LASTFM_API_BASE_URL=https://ws.audioscrobbler.com/2.0/
LASTFM_TIMEOUT_MS=10000
LASTFM_MAX_RETRIES=3
LASTFM_MIN_REQUEST_INTERVAL_MS=250
LASTFM_CACHE_TTL_SECONDS=300

# Persistent normalized scrobble index
HISTORY_DB_PATH=/app/data/lastfm.sqlite
HISTORY_LIVE_SCAN_LIMIT=5000
HISTORY_MAX_SYNC_TRACKS=250000
